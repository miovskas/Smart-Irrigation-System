<Window x:Class="IrrigationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IrrigationSystem"
        mc:Ignorable="d"
        Title="Интелигентна система за поливане" 
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Background="#F4F7F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
        Background="#2E7D32">

            <Grid>
                <TextBlock Text="Интелигентна система за поливане"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="30,0,0,0"/>

                <Border x:Name="TestModeIndicator"
                Background="#FFF3E0"
                CornerRadius="8"
                Padding="12,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,30,0"
                Visibility="Collapsed">

                    <TextBlock Text="ТЕСТОВ РЕЖИМ"
                       Foreground="#E65100"
                       FontSize="14"
                       FontWeight="Bold"/>

                </Border>
            </Grid>

        </Border>
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Влажност на почвата -->
                <Border Grid.Column="0"
                Margin="0,0,10,0"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D5DDD7"
                BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="Влажност на почвата"
                           FontSize="16"
                           Foreground="#555555"/>

                        <TextBlock x:Name="SoilValueText"
                           Text="---"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Температура -->
                <Border Grid.Column="1"
                Margin="10,0"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D5DDD7"
                BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="Температура"
                           FontSize="16"
                           Foreground="#555555"/>

                        <TextBlock x:Name="TemperatureValueText"
                           Text="--- °C"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Влажност на въздуха -->
                <Border Grid.Column="2"
                Margin="10,0"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D5DDD7"
                BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="Влажност въздух"
                           FontSize="16"
                           Foreground="#555555"/>

                        <TextBlock x:Name="HumidityValueText"
                           Text="--- %"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Ниво на водата -->
                <Border Grid.Column="3"
                Margin="10,0,0,0"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D5DDD7"
                BorderThickness="1">

                    <StackPanel Margin="20">

                        <TextBlock Text="Ниво на водата"
                           FontSize="16"
                           Foreground="#555555"/>

                        <TextBlock x:Name="WaterValueText"
                           Text="---"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>
            <!-- Управление и състояние -->
            
                <Border Grid.Row="1"
        Margin="0,20,0,0"
        Background="White"
        CornerRadius="12"
        BorderBrush="#D5DDD7"
        BorderThickness="1"
        Padding="25"
        VerticalAlignment="Top">

                    <StackPanel>

                        <TextBlock Text="Управление на системата"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#333333"/>

                        <!-- Режим и помпа -->
                        <StackPanel Orientation="Horizontal"
                    Margin="0,25,0,0">

                            <TextBlock Text="Режим:"
                       FontSize="16"
                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="ModeValueText"
                       Text="AUTO"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#2E7D32"
                       Margin="10,0,40,0"
                       VerticalAlignment="Center"/>

                            <TextBlock Text="Помпа:"
                       FontSize="16"
                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="PumpValueText"
                       Text="OFF"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#777777"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Последно поливане -->
                        <StackPanel Orientation="Horizontal"
                    Margin="0,12,0,0">

                            <TextBlock Text="Последно поливане:"
                       FontSize="16"
                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="LastIrrigationText"
                       Text="Няма данни"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="Gray"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <!-- Състояние на системата -->
                        <StackPanel Margin="0,25,0,0">

                            <TextBlock Text="Състояние на системата:"
                       FontSize="16"
                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="SystemStatusText"
                       Text="Очакване на данни..."
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Gray"
                       Margin="0,8,0,0"/>

                            <TextBlock x:Name="WarningText"
                       Text=""
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#C62828"
                       Margin="0,8,0,0"/>

                        </StackPanel>

                        <!-- Бутони за управление -->
                        <StackPanel Orientation="Horizontal"
                    Margin="0,25,0,0">

                            <Button x:Name="AutoButton"
                    Content="AUTO"
                    Width="130"
                    Height="45"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Margin="0,0,15,0"
                    Click="AutoButton_Click"/>

                            <Button x:Name="ManualOnButton"
                    Content="MANUAL ON"
                    Width="130"
                    Height="45"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Margin="0,0,15,0"
                    Click="ManualOnButton_Click"/>

                            <Button x:Name="ManualOffButton"
                    Content="MANUAL OFF"
                    Width="130"
                    Height="45"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Margin="0,0,15,0"
                    Click="ManualOffButton_Click"/>

                            <Button x:Name="TestDataButton"
                    Content="Тестови данни"
                    Width="130"
                    Height="45"
                    Click="TestDataButton_Click"/>

                        </StackPanel>

                        <!-- Серийна връзка -->
                        <StackPanel Orientation="Horizontal"
                    Margin="0,25,0,0">

                            <TextBlock Text="COM порт:"
                       FontSize="16"
                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="PortComboBox"
                      Width="120"
                      Height="35"
                      Margin="10,0,15,0"
                      FontSize="14"/>

                            <Button x:Name="ConnectButton"
                    Content="Свързване"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    Margin="0,0,20,0"
                    Click="ConnectButton_Click"/>

                            <TextBlock Text="Състояние:"
                       FontSize="16"
                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="ConnectionStatusText"
                       Text="Не е свързано"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#C62828"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

              
                <Border Grid.Row="2"
        Background="White"
        CornerRadius="12"
        BorderBrush="#D5DDD7"
        BorderThickness="1"
        Padding="20"
        Margin="0,20,0,20">

                    <StackPanel>
                        <TextBlock Text="История на измерванията"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

                        <ListBox x:Name="HistoryListBox"
                 Height="200"
                 FontSize="14"/>
                        <Button x:Name="ClearHistoryButton"
        Content="Изчистване на историята"
        Width="180"
        Height="35"
        HorizontalAlignment="Left"
        Margin="0,15,0,0"
        Click="ClearHistoryButton_Click"/>
                    </StackPanel>

                </Border>

            </Grid>
        </ScrollViewer>

    </Grid>
   
</Window>
